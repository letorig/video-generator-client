# Seedance 
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=

# Kling
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api.klingai.com

# MiniMax
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=

# Alibaba DashScope / Wan
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# OrcaRouter
# Paste an existing key here, or leave it blank and run `video-gen orcarouter login`
# to sign in with your OrcaRouter account. Both produce the same kind of key.
ORCAROUTER_API_KEY=
# Origins are optional. Defaults: auth https://www.orcarouter.ai, API https://api.orcarouter.ai/v1
# ORCA_BASE_URL=
# ORCA_AUTH_BASE_URL=
# ORCA_API_BASE_URL=

# Polling
POLL_INTERVAL=5
POLL_TIMEOUT=600
